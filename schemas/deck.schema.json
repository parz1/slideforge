{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slideforge.local/schemas/deck.schema.json",
  "title": "Slideforge Layout-First Deck Spec",
  "type": "object",
  "required": ["meta", "slides"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "language", "theme"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "theme": { "type": "string", "minLength": 1 },
        "template": {
          "type": "string",
          "enum": ["teaching", "clean"]
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "accent": { "type": "string" },
        "background": { "type": "string" },
        "text": { "type": "string" },
        "muted": { "type": "string" },
        "logo": { "type": "string" },
        "footer": { "type": "string" },
        "fontFamily": { "type": "string" }
      }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "layoutId": {
      "type": "string",
      "enum": [
        "title-cover",
        "section-divider",
        "bullet-list",
        "two-column",
        "image-left-text-right",
        "progress-dashboard",
        "system-flow",
        "quote-callout",
        "code-walkthrough",
        "exercise-checklist",
        "lab-progress",
        "research-system-concept"
      ]
    },
    "slideType": {
      "type": "string",
      "enum": [
        "cover",
        "section",
        "bullet_summary",
        "comparison",
        "metric_grid",
        "principle_card",
        "code_explain",
        "trace_table",
        "process",
        "workflow",
        "checklist",
        "two_column",
        "note_callout",
        "closing"
      ]
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["none", "step_reveal", "highlight_key_points"]
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "path", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[^\\\\]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["image", "text"]
        },
        "description": { "type": "string" }
      }
    },
    "visual": {
      "type": "object",
      "required": ["assetId"],
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "alt": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["primary", "supporting"]
        }
      }
    },
    "slide": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "layout": { "$ref": "#/$defs/layoutId" },
        "props": {
          "type": "object",
          "additionalProperties": true
        },
        "type": { "$ref": "#/$defs/slideType" },
        "content": {
          "type": "object",
          "additionalProperties": true
        },
        "visual": { "$ref": "#/$defs/visual" },
        "speakerNotes": {
          "type": "string"
        },
        "animation": { "$ref": "#/$defs/animation" }
      },
      "anyOf": [
        { "required": ["layout", "props"] },
        { "required": ["type", "content"] }
      ]
    }
  }
}
