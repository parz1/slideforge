{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slideforge.local/schemas/deck.schema.json",
  "title": "Slideforge Deck Spec",
  "type": "object",
  "required": ["meta", "slides"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "language", "theme"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "theme": { "type": "string", "minLength": 1 },
        "template": {
          "type": "string",
          "enum": ["teaching"]
        }
      }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "slideType": {
      "type": "string",
      "enum": [
        "cover",
        "section",
        "bullet_summary",
        "comparison",
        "metric_grid",
        "principle_card",
        "code_explain",
        "trace_table",
        "process",
        "workflow",
        "checklist",
        "two_column",
        "note_callout",
        "closing"
      ]
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["none", "step_reveal", "highlight_key_points"]
        }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "path", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[^\\\\]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["image", "text"]
        },
        "description": { "type": "string" }
      }
    },
    "visual": {
      "type": "object",
      "required": ["assetId"],
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "alt": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["primary", "supporting"]
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metric": {
      "type": "object",
      "required": ["label", "value", "note"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "card": {
      "type": "object",
      "required": ["title", "body"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "column": {
      "type": "object",
      "required": ["title", "items"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "items": { "$ref": "#/$defs/stringArray" }
      }
    },
    "workflowStep": {
      "type": "object",
      "required": ["label", "body"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "slide": {
      "type": "object",
      "required": ["id", "type", "title", "content"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "type": { "$ref": "#/$defs/slideType" },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "object"
        },
        "visual": { "$ref": "#/$defs/visual" },
        "speakerNotes": {
          "type": "string"
        },
        "animation": { "$ref": "#/$defs/animation" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "cover" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "subtitle": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "bullet_summary" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "required": ["points"],
                "additionalProperties": false,
                "properties": {
                  "points": { "$ref": "#/$defs/stringArray" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "metric_grid" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "required": ["metrics"],
                "additionalProperties": false,
                "properties": {
                  "metrics": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/metric" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "principle_card" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "required": ["cards"],
                "additionalProperties": false,
                "properties": {
                  "cards": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/card" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "code_explain" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "required": ["language", "code"],
                "additionalProperties": false,
                "properties": {
                  "language": { "type": "string" },
                  "code": { "type": "string" },
                  "note": { "type": "string" },
                  "points": { "$ref": "#/$defs/stringArray" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "trace_table" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "required": ["columns", "rows"],
                "additionalProperties": false,
                "properties": {
                  "columns": { "$ref": "#/$defs/stringArray" },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": ["string", "number", "boolean", "null"]
                      }
                    }
                  },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "process" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "required": ["steps"],
                "additionalProperties": false,
                "properties": {
                  "steps": { "$ref": "#/$defs/stringArray" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "workflow" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "required": ["steps"],
                "additionalProperties": false,
                "properties": {
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/workflowStep" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "checklist" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "required": ["items"],
                "additionalProperties": false,
                "properties": {
                  "items": { "$ref": "#/$defs/stringArray" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["comparison", "two_column"] }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "required": ["columns"],
                "additionalProperties": false,
                "properties": {
                  "columns": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "$ref": "#/$defs/column" }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "note_callout" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "required": ["body"],
                "additionalProperties": false,
                "properties": {
                  "body": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "closing" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "statement": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "section" } } },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "additionalProperties": false,
                "properties": {}
              }
            }
          }
        }
      ]
    }
  }
}
